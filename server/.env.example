# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ──────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → your cluster → Connect → Drivers → copy the URI
# Replace <username>, <password>, and keep the db name as "mockmate"
MONGODB_URI=

# ── Google OAuth ───────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Add http://localhost:5000/auth/google/callback to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ── JWT Secrets ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Run that command TWICE — use one for each secret below (keep them different)
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ── Frontend URL ───────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Gemini AI ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=


# ── Redis ──────────────────────────────────────────────────────────────────
# Used only for leaderboard cache. For local dev, run Redis on default port.
# If you don't have Redis locally, the leaderboard cache will just error silently.
# Local: redis://127.0.0.1:6379
# Upstash (free cloud): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Razorpay (get from Razorpay Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Webhook secret (set when you create a webhook in Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

CRON_SECRET=mockmate_cron_abc123